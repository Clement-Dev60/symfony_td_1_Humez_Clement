{# templates/admin/forms.html.twig #}
{% extends 'base.html.twig' %}

{% block body %}
    {% for message in app.flashes('success') %}
        <div style="background: rgba(99,102,241,0.2); border: 1px solid var(--primary); border-radius: 12px; padding: 12px 20px; margin-bottom: 1rem;">
            ✅ {{ message }}
        </div>
    {% endfor %}

    <h1>Administration</h1>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
        <div class="glass-card">
            <h3>Nouvelle Promo</h3>
            {% include 'promo/new.html.twig' with { form: promoForm } %}
        </div>
        <div class="glass-card">
            <h3>Nouvelle News</h3>
            {% include 'news/new.html.twig' with { form: newsForm } %}
        </div>
        <div class="glass-card" style="grid-column: span 2;">
            <h3>Nouvel Événement</h3>
            {% include 'event/new.html.twig' with { form: eventForm } %}
        </div>
    </div>
{% endblock %}